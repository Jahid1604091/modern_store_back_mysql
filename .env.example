# Server
PORT=5000
NODE_ENV=development

# Database (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=modern_store
DB_USER=root
DB_PASSWORD=

# JWT
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRED_IN=7d

# CORS — comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# App
APP_NAME=ModernStore
ADMIN_URL=http://localhost:5173

# SMTP (for password reset & welcome emails)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_EMAIL=your_smtp_user
SMTP_PASSWORD=your_smtp_password
FROM_NAME=ModernStore
FROM_EMAIL=noreply@modernstore.com

# Used to encrypt per-company courier credentials (Steadfast API key/secret) at rest
ENCRYPTION_KEY=change_me_to_a_long_random_string

# COD fraud-check provider: "stub" (default, no external calls) or "fraudbd"
FRAUD_CHECK_PROVIDER=stub
FRAUDBD_API_KEY=

# Override only if Steadfast's API base URL changes
STEADFAST_BASE_URL=https://portal.packzy.com/api/v1
